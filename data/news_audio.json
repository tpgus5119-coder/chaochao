{"Chưa. Vẫn còn chậm vì thiếu công nhân.": "f6ff0981efaa", "Công việc này xong chưa?": "714f443d43a8", "Phòng này to không?": "78f74475d8ed", "Vâng, và rất đẹp.": "1b893a812131", "Anh nói tiếng Anh giỏi không?": "9852cfdb2aad", "Bạn đã đi phỏng vấn ở công ty Hàn Quốc chưa?": "57b5874a2253", "Có người rủ tôi sang Campuchia làm việc lương cao.": "7c3278789032", "Có, ngày càng nhiều.": "33f49491a5b5", "Công ty Hàn Quốc ở Đà Nẵng có nhiều không?": "53b580ddfae7", "Công ty này có an toàn không?": "77da21a2a2bd", "Hôm nay chứng khoán tăng hay giảm?": "360bc6197f66", "Không, cẩn thận bị lừa đảo!": "dca8607862a5", "Mua nhà gần ga tàu điện có đắt không?": "526e45c93c29", "Nhà máy của bạn đã dùng máy móc mới chưa?": "17a4add40fd3", "Rồi, năng suất tăng nhiều lắm.": "45c02fbda70c", "Rồi, tuần sau tôi sẽ biết kết quả.": "9952b324e1c4", "Sau khi tốt nghiệp, bạn muốn làm việc ở đâu?": "e1e52f5dfb2c", "Sáng nay bạn đến công ty sớm thế?": "fe81787e35db", "Tôi biết nói một chút.": "ce3806697c7e", "Tôi muốn làm việc ở Hàn Quốc.": "9f31aefb3787", "Tăng, cổ phiếu ngân hàng tăng mạnh.": "966e2509b9fc", "chuyển đổi số": "f6e8ea865dfe", "cư trú": "e08c4943e88d", "giấy phép xây dựng": "74129e5219e6", "nhà máy thông minh": "0a5abd33d934", "phí gửi xe": "b3676f5ee414", "quá hạn": "c184ec2b9fd7", "tăng điểm": "397b6d9b9b10", "Được, anh quét mã này nhé.": "74578b72ed7a", "Đắt hơn, nhưng đi lại tiện hơn.": "9ec0ebf2f39d", "đường sắt đô thị": "01a4b2db777e", "Ở đây sẽ xây nhà ở xã hội à?": "f7844906e43b", "Ở đây trả bằng chuyển khoản được không?": "deb130eb5716", "Ừ, công nhân sẽ có nhà giá rẻ hơn.": "6381ad5261d9", "Ừ, đến muộn là hết chỗ đỗ xe.": "d0edff61e6a9"}