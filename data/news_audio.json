{"Anh có mua vé số không?": "4d094148bce5", "Anh làm việc ở công ty nào?": "1dba6ca8ebee", "Anh đi làm bằng xe điện à?": "4462f06ffec5", "Anh định mua ô tô mới năm nay không?": "09319d2c8338", "Bạn tôi ngủ ở nhà tôi một đêm, có phải khai báo không?": "452ca45ae5e0", "Chưa, tôi chờ mẫu xe mới cuối năm.": "44818709dce1", "Chưa, tôi sẽ nộp hồ sơ sớm.": "d2b3c3df2948", "Có cháy ở đâu vậy?": "63a5b7d02b07", "Công ty bảo hiểm này có lợi nhuận tốt không?": "0e9694620801", "Mùa đông này anh đi đâu?": "d867e2fd94ff", "Nhà đây có tốt không?": "d994210f7955", "Phòng này nóng quá, bật quạt nhé?": "94bcf3dbbe46", "Tôi làm ở công ty Việt Nam.": "531a931dfd95", "Vâng, anh bật quạt lên đi.": "ec8309b8a7df", "Vâng, lợi nhuận tăng nhiều năm nay.": "adcee6daacf8", "Vâng, nhà mới rất tốt.": "947fca658e24", "Vâng, xe điện này rất tốt.": "986b49aeb27e", "Ở nhà kho, hãy ra ngoài!": "a3610d39cc66", "Anh đã nghe tin tức mới chưa?": "7324141b2b94", "Anh đã đặt lịch hẹn chưa?": "f0f19e0fb84a", "Chiều nay tôi đi bác sĩ răng.": "feb4cc88c950", "Có chứ, không đội bị phạt đấy.": "a53066d205da", "Nghe nói bị chậm rồi.": "2c5a336f2cc6", "Ngày 24 tháng 12.": "8aa82422a598", "Sân bay Long Thành khai trương ngày nào?": "81fcfdb87700", "Sân bay mới bao giờ mở cửa?": "b9cca00937d5", "Tôi chưa xem, có tin gì vậy?": "7ab66f9f9aaf", "lịch hẹn": "df5163176ad1", "Đi xe máy có phải đội mũ không?": "ae11146c3920", "Bánh mì heo có ngon không?": "5768e110b4e4", "Có, rất ngon. Anh muốn ăn không?": "9107219f56c6", "Có, tuần sau công ty tổ chức.": "6ba429d80055", "Công ty có tiêm vắc xin không?": "45f94d13a366", "Giá vé vẫn như cũ.": "f00113e66da2", "Tiền đã gửi đến ngân hàng chưa?": "aa42421b4daf", "Vâng, tôi đã kiểm tra tài khoản.": "4925a4c0e960", "Xe buýt này giá vé bao nhiêu?": "a3a56b4884e9", "vắc xin": "6b1f11d725e4", "Giám đốc mới là ai?": "dd031aab5a2d", "Không, ngày mai là ngày nghỉ.": "6c3c2216786f", "Ngày mai có đi làm không?": "367fea30b947", "Nó mở ngày 24 tháng 12.": "68b534955d38", "Sân bay mới mở khi nào?": "f724f186c3d9", "Tôi không biết giám đốc mới.": "b2361d3ed27b", "Anh ơi, cuộc gọi này có lừa đảo không?": "8e5eeaae3a1d", "Chúng ta làm dự án đường sắt.": "0de7f60b755b", "Công ty mình làm dự án gì?": "7868060d08e5", "Giá cổ phiếu giảm nhiều rồi.": "0e151951c5c5", "Thị trường hôm nay thế nào?": "d8bebbc50d94", "Tàu này đi Hà Nội.": "efbcf1edd49d", "Tàu này đi đâu?": "97290c81c702", "Đừng chuyển tiền, lừa đảo đấy!": "6ce30b5b1b2d", "Anh chị định có mấy con?": "7260d53fe124", "Anh muốn đặt một phòng cho hai đêm.": "1d4dd519f632", "Anh định mua xe máy điện à?": "9d6c3dc4992e", "Chi phí du học có đắt không?": "296d123f6d2e", "Chưa, em sẽ mua trả góp thôi.": "c5eeb2ea149e", "Chắc chỉ một con thôi, nuôi con tốn lắm.": "5a761d612c19", "Chắc khách sạn ở đó sẽ kín phòng.": "15bb387d31c0", "Chủ yếu sang Trung Quốc đấy.": "91c2b1a5d2e8", "Còn lâu lắm, bây giờ mới thiết kế thôi.": "520992d17664", "Dạ, anh cho em xin tên ạ.": "d647d767ec65", "Dạ, chất lượng rất tốt rồi.": "d077e7ffae88", "Em bị đau răng mấy hôm nay.": "4d588a8abdd3", "Em học du lịch, chắc em sẽ nộp hồ sơ.": "9be1445f3a95", "Em nên đi khám nha sĩ sớm đi.": "77f8cb977bc2", "Em đã mua trang sức ở cửa hàng này chưa?": "168224ce6205", "Giá vàng giảm nhiều quá, có nên mua không?": "fb5368c88cb5", "Hay quá, em sẽ về quê.": "c31a10f0af1f", "Học phí ở đây rất đắt.": "bb7aae17972d", "Khi nào có tàu cao tốc từ Hà Nội vào Sài Gòn?": "b4e127c1a88e", "Mỹ phẩm Hàn Quốc bán chạy ở Việt Nam không?": "c18cd60863e4", "Nghe nói Phú Quốc đang tuyển rất nhiều người.": "ac36586c59c1", "Ngân hàng Hàn Quốc mới mở chi nhánh ở Hà Nội.": "2d7b67a247a6", "Năm sau hội nghị lớn tổ chức ở Phú Quốc đấy.": "f85483a53d1b", "Năm sau mình được nghỉ thêm hai ngày lễ.": "91255cb18e00", "Quán cà phê nào ngon ở đây?": "de59554dbc8a", "Quán này cà phê rất ngon.": "7a0ef7fa32ce", "Rất chạy, người mua ở đây rất thích.": "e15c0e8c40fa", "Rồi, nhưng bây giờ em hơi lo.": "cfbf607a894d", "Sầu riêng Việt Nam xuất khẩu đi đâu nhiều nhất?": "476e53dd57aa", "Tôm xuất khẩu đã kiểm tra chưa?": "90ffc1222094", "Vậy chủ đất nên sớm xây nhà thôi.": "0c6e866be8e0", "Vậy công ty mình vay vốn dễ hơn rồi.": "9fbba64ed4ed", "bỏ hoang": "b80e02f9ff96", "ca làm việc": "90bd5d2b7e95", "nha sĩ": "0dc33b850ab2", "tốc độ cao": "3c2cb7b96b0c", "Điện thoại mới đắt quá, em mua chưa?": "c6751c449dc9", "Đất bỏ hoang sẽ phải đóng thuế cao hơn.": "88d756eefa4e", "Đừng vay tiền để mua vàng nhé.": "a10f6dbd7402", "Ừ, không tốn tiền xăng mà.": "3662ec21957f", "Anh muốn ăn bánh mì không?": "5c4664a9a219", "Có, bánh mì ở đây rất ngon.": "0d557b5cb75a", "Đây là làng gì?": "2821d3701b62", "Đây là làng nhà cây.": "e47e17585749", "Bà của em có hay đi khám sức khỏe không?": "7df7897f5292", "Canh cá này ngon không?": "dc40e27b835e", "Chắc họ đang tuyển thêm nhân viên đấy.": "f1a71bd2faff", "Chủ yếu sang Trung Quốc và Nhật Bản.": "ff02d2f35af4", "Có, em thích xem phát trực tiếp rồi mua.": "17ffbeebeec7", "Có, tháng nào bà cũng đi khám.": "e5f777b3a587", "Có, tiền lương tăng gấp ba.": "a3ab0d7a7a2b", "Công nhân có mua được nhà ở xã hội không?": "f0834baedd3f", "Công trường này dùng công nghệ mới đấy.": "9eae672860f8", "Công ty bảo hiểm mới mở văn phòng gần đây.": "1fe2534fd28f", "Công ty mình sắp có buổi học về an toàn lao động.": "e0acbe0e5540", "Công ty mình đã dùng trí tuệ nhân tạo chưa?": "b5a6873ecba1", "Dạ, rất ngon. Ăn cơm đi.": "946f3f0a5dd9", "Em có hay mua đồ trên mạng không?": "f32f3113fdf2", "Em hay gọi xe bằng ứng dụng nào?": "c92ca725f2bd", "Em học điện tử, em sẽ thử nộp hồ sơ.": "7e1e21981d9f", "Em thích xe điện vì rất yên tĩnh.": "9059e1a20919", "Em định thuê căn hộ vài ngày ở Hà Nội.": "50c50ae6bccf", "Gỗ Việt Nam xuất khẩu đi đâu nhiều nhất?": "9a35e5766cf2", "Hay quá, chắc an toàn hơn trước.": "2a905cff7c0b", "Là chủ tịch một tập đoàn lớn.": "31771a27f08e", "Ngày lễ đi làm có thêm lương không?": "fae47c12ba0e", "Người giàu nhất Việt Nam là ai vậy?": "91b5f71cb261", "Nhà máy của anh phải di dời ra ngoại thành à?": "e3abe784ac2f", "Nhà máy này dùng điện mặt trời à?": "ad049447205f", "Nhà máy ở Hải Phòng đang tuyển kỹ sư.": "271eb317b255", "Rồi, mình dùng để dịch tin nhắn.": "2ff936560d50", "Sắp tới việc đó sẽ hợp pháp rồi.": "174be03cbd56", "Tốt quá, ai cũng nên tham gia.": "a724b505af05", "Tỷ giá đô la lại tăng rồi.": "2438aecf8aeb", "Vậy em sẽ đổi tiền sau.": "141591fa3687", "Được, giá rẻ hơn nhà bình thường nhiều.": "e9968edb3d30", "đô thị mới": "c4a39e7a5a70", "Ừ, nhưng anh mong có thêm thời gian.": "cdc8fd6a4627", "Ừ, trên mái toàn là tấm pin.": "20161b03be01", "Có, nhưng dạo này đang bị lỗ.": "4a9b48e4206b", "Doanh thu tháng này thế nào?": "ba8ae9c12775", "Doanh thu tháng này tăng rồi.": "1e8714ea6e85"}