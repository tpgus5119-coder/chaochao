{"Bạn có giữ cửa cho người sau không?": "70cef4ab20cd", "Bạn cần điểm tiếng Hàn trước.": "4b0a249659ab", "Bệnh viện này có đông không?": "96fe34d14e5f", "Chủ yếu là vải, thép và phân bón.": "75837ed15292", "Có, nhưng họ cũng mua cổ phiếu mới.": "e59b3c5612a7", "Có, phải xếp hàng rất lâu.": "31b993d0d339", "Có, đó là phép lịch sự.": "cdbe6771b0dc", "Doanh thu của công ty này thấp hơn dự kiến.": "30db2023fcf3", "Hà Nội sẽ mở thêm đường mới.": "7bd7b93b7291", "Hôm nay có đi Sơn Trà không?": "3c9f62a4a13e", "Hôm nay ăn phở không?": "f9509aea00c2", "Khó lắm, lãi suất vẫn còn cao.": "b98da5060737", "Không, trời mưa to lắm.": "314a2dd6b97f", "Nhà đầu tư nước ngoài bán ròng nhiều không?": "0e7f5913a9cb", "Năm sau giá nhà có giảm không?": "d5595d4ce2a2", "Quán cà phê Việt Nam mới khai trương ở Mỹ.": "c345e9e57160", "Trường này đang thiếu giáo viên tiếng Anh.": "3d1dde92320b", "Tôi có thể dạy tiếng Anh.": "a037568a66e3", "Tôi muốn làm thêm ở Hàn Quốc.": "d1364c3dbe90", "Tôi muốn thử cà phê ở đó.": "899fd79d465f", "Tươi lắm, hôm nay rất rẻ.": "126bb4e8f6ce", "Việt Nam xuất khẩu gì sang Campuchia?": "0936e5bd277e", "Vì vậy cổ phiếu công nghệ giảm.": "42213e39ddb2", "bán ròng": "080857927a4a", "du học sinh": "22f94fb59129", "giá nhà": "ad7a07c58281", "nhượng quyền": "7c968915b2de", "Đi làm sẽ nhanh hơn.": "54395bbdf96b", "Được, quán này rất ngon.": "dd011c1ea2c9"}