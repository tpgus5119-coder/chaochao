{"Anh muốn đi bệnh viện không?": "7a33051725f2", "Có, tôi muốn đi khám bệnh.": "0efe851df834", "Trang web du lịch này có ngôn ngữ Hàn Quốc không?": "20a4a8f7a6df", "Tôi muốn đăng ký hội nghị này.": "1ae65fb15b8e", "Vâng, bạn cần hỗ trợ gì?": "f3a5e0c76cab", "Vâng, có. Nó có 10 ngôn ngữ mới.": "8d3d3308b9ef", "Anh chở tôi đi đường dài được không?": "12c3565befdf", "Anh có nói tiếng Anh không?": "d77e12f02863", "Bạn có cần thị thực không?": "be78355482eb", "Bạn có thích xem phim không?": "01b8f94791be", "Bạn có đầu tư cổ phiếu không?": "ec4b5ff91f8a", "Bạn hay mua hàng trên mạng không?": "8e112eab8a4a", "Bạn đặt vé máy bay chưa?": "49e39f7f29f4", "Bệnh viện này có nhiều trẻ em không?": "1de22ac79044", "Chúng tôi sản xuất hàng điện tử.": "e9be7ed86d53", "Có, gần như mỗi tuần.": "5f09ce9ed609", "Có, tôi có thể làm việc bằng tiếng Anh.": "38918fe3dba9", "Có, tôi học cùng câu lạc bộ.": "cb138ee8678b", "Có, tôi thích xem phim lắm.": "0fde222a31e7", "Công ty bạn làm dự án gì?": "9a701b7e03f1", "Dự án điện gió ngoài khơi.": "5ae62b3ebf00", "Giá xăng giảm rồi đấy.": "aa9714cf177c", "Họ đang mở rộng đường đấy.": "ed722c6bc24c", "Mong giá taxi cũng giảm theo.": "fb2728425935", "Mua tủ lạnh trả góp được không?": "7e357af9e2c0", "Ngân hàng nhà nước mua đô la à?": "2e665f2d4d96", "Nhà máy mới này sản xuất gì?": "6d9b27bcf680", "Phòng này có tủ lạnh thông minh à?": "4cb1449d09ba", "Rồi, tôi mua vé giá rẻ.": "8ae5164bf7a6", "Tôi dùng mạng mới, tốc độ rất nhanh.": "f0bb1bbe0c04", "Tối đó đi xem pháo hoa không?": "519c8157cc18", "Vâng, có rất nhiều trẻ em đến đây chơi.": "77060b34d394", "Vâng, khách có thể dùng thử.": "6fc53e77ee41", "Vâng, đây là công ty nước ngoài lớn.": "d6cfccf7c797", "dự trữ ngoại hối": "9aa5df5f3887", "giá cước": "8893d8ef2080", "kinh tế số": "4f8251d488c1", "mua vào": "2182c841fab6", "trả góp": "a392d5ffb4c7", "vỉa hè": "e22290d2a09c", "Đi chứ, mình đi sớm nhé.": "e77573e9dbed", "Điện thoại của bạn dùng mạng gì?": "c0d56c2fb645", "Đây là công ty nước ngoài à?": "518c49703f76", "Được, chị đặt cọc trước nhé.": "3c0fb5075eb3", "Được, lãi suất không phần trăm.": "75934356100c", "điện máy": "f6083f859e15", "đường dài": "220832d74622", "Ở Bắc Ninh, gần Hà Nội.": "0c5877a73f41", "Ừ, cổ phiếu ngân hàng cũng tăng.": "7e60852a34a9", "Có, trời mưa và gió.": "35d75d4c9849", "Giá vàng ở đây có đắt không?": "f2ba8e6ee587", "Hàng hóa này đi đâu?": "17f2a64a217f", "Nhà máy mới này lớn không?": "de2c50aa029e", "Nó đi cảng.": "ff9a49213399", "Sao đường này tắc thế?": "58e5b9a58a0e", "Sân bay mới ở đâu vậy?": "2312d12b07d0", "Trời có mưa không?": "8d16bdebe22a", "Vàng ở đây thường đắt hơn.": "fa75ed6f2af8", "Vâng, rất lớn. Họ bắt đầu xây dựng năm nay.": "cd7a9c7b5bce", "hóa chất": "bd137b7ae27e", "ngoài khơi": "16d9a1040a0d", "Đúng, để tăng dự trữ ngoại hối.": "c89439994ea4"}