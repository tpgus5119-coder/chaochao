{"Bạn đi làm ở nhà máy mới hả?": "e07bd494aff8", "Chúng ta cần học kỹ năng mới.": "284e02e25589", "Có nhiều khách du lịch không?": "e0706ed4e96a", "Có, mình đầu tư dự án này.": "a947c794ff50", "Công ty mình có giảm nhân viên không?": "2acc12e1543e", "Công ty mình có đầu tư không?": "c30123f1d6a1", "Khu này có dự án mới không?": "7dd77c7aaa52", "Không, công ty mình đang tuyển người.": "05d4c00d4514", "Làm thế nào để tăng năng suất?": "0453f3e927ab", "Vâng, có dự án xây dựng lớn quanh hồ.": "68d810a11ff2", "Vâng, có nhiều người nước ngoài đến.": "7d570ca4f383", "Vâng, tôi đi làm, rất vui.": "837afb10eca1", "hội viên": "3d42539209be", "Chúng tôi xuất khẩu sản phẩm điện thoại.": "46082113ca85", "Chúng tôi đã ký hợp đồng rồi.": "d342dd2721f0", "Công nhân này làm việc nhanh không?": "22248704c79c", "Công ty này xuất khẩu gì?": "005fe8223666", "Công ty đã tuyển nhân viên chưa?": "e84251d04631", "Vâng, anh ấy làm việc rất năng suất.": "812196513fd2", "Chúng tôi sản xuất đồ điện tử.": "a072ed95d0ae", "Hai triệu rưỡi, đắt quá anh ạ.": "66e42c0c8063", "Nhà máy mình sắp mở rộng à?": "c1a735fb1887", "Nhà máy sản xuất cái gì thế?": "e16d66f14b48", "Từ sân bay về đây bao nhiêu tiền?": "0d30564fc519", "Đúng rồi, kinh tế đang phát triển.": "536bc355a1e0", "Bỏ vào thùng rác kia nhé.": "44fb7e6b0d2e", "Có, tôi muốn đi thuyền ngắm hang.": "df37453c73fb", "Rác nhựa bỏ ở đâu ạ?": "535761032504", "Thời tiết đẹp, anh đi du lịch không?": "b803c1c91232", "suối nước nóng": "dd3f3fa32a95", "Có, tiền điện tháng này giảm rồi.": "fec4d128deab", "Công ty làm nhà và xe.": "56409196f71b", "Công ty này làm gì?": "ee23b0ac8243", "Tiền điện công ty có giảm không?": "53dffe17516c", "Cuối tuần anh đi du lịch không?": "9281c8ac5a98", "Có, tôi đi biển với bạn.": "a71c394b0456", "Giá hơi đắt nhưng rất ngon.": "24793732f259", "Phở gà ở đây có đắt không?": "babde53712a8", "Có, nhà máy này rất lớn.": "ad7641dfa7c1", "Có, đối tác nước ngoài sẽ đến.": "8250f79afb23", "Công ty dùng điện mặt trời à?": "d7fce348dbed", "Em ơi, quét mã được không?": "8c91d5935d1f", "Hiện tại chưa có.": "b1a27ecda772", "Hôm nay có đối tác đến không?": "0be14dcd0c27", "Hôm nay nhà máy sản xuất tốt không?": "a7e91a1bc238", "Nhà máy có sản xuất không?": "f78224f017c1", "Nhà máy này có lớn không?": "77eb695a8345", "Tháng này tiền điện giảm phải không?": "19beaacbaa8d", "Tốt, năng suất đang tăng lên.": "5d5ef342df76", "Vâng, tiền điện vừa giảm rồi.": "f770e988052f", "Vâng, để tiết kiệm điện.": "8d4945daa772"}