{"Anh có đầu tư cổ phiếu không?": "7ccf05e2fb77", "Bạn làm việc ở đâu?": "afc97a091e7e", "Chưa có, nhưng sắp có nhiều hơn.": "e6b249a9eb5c", "Có nhà hàng ở gần đây không?": "d7a055be7754", "Có, giám đốc đang làm việc.": "7a15dc59295a", "Có, nhưng đơn hàng xuất khẩu giảm.": "5cf2cc4f11ba", "Có, tôi đang đầu tư cổ phiếu.": "8639c5d60be0", "Có, được gia hạn đến cuối năm.": "972821d596ae", "Doanh nghiệp phải thu hồi và tái chế.": "fb880e3e96e3", "Gần nhà bạn có siêu thị Aeon không?": "9c40fc9413e3", "Khi nào sân bay Long Thành mở cửa?": "c25117eee096", "Nhà máy của bạn có nhiều đơn hàng không?": "9ae1f407f9d8", "Nhà đầu tư nước ngoài đang bán cổ phiếu à?": "dc5424054f74", "Pin xe điện cũ sẽ đi đâu?": "54fc31b147f4", "Quán này đông khách quá.": "de3dd8d3e0f5", "Sáu mươi bảy, tăng mười bảy bậc.": "dce8d7b0fb60", "Thuế xăng có được miễn tiếp không?": "3a03db365caf", "Thành phố Hồ Chí Minh xếp hạng bao nhiêu?": "da65101f37ba", "Tháng mười hai năm nay.": "cb8df416f500", "Trung tâm AI mới sẽ làm gì?": "6ea663f03574", "Tôi cần gọi điện cho luật sư.": "2bacd6f61d09", "Tôi làm việc từ xa ở quán cà phê.": "fb359891152e", "Tôi sẽ giúp đỡ bạn tìm phiên dịch.": "a770e8155b41", "Vâng, bạn có thể ăn ở nhà hàng công ty.": "15abb12dc8e6", "Vâng, nhưng vốn mới sẽ vào nhiều hơn.": "480fc424ec23", "Vâng, đồ ăn ngon và rẻ.": "0c14b53cf695", "Xem biểu diễn và may áo dài.": "3fd4dbead10b", "thu hồi": "9f61c6e1fd60", "trí tuệ nhân tạo": "c50acefaa867", "Đào tạo người học và hỗ trợ khởi nghiệp.": "4f5a2a4142bb", "Ở làng này có gì vui?": "9336f3f3e886"}