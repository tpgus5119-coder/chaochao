{"Anh tôi sắp sang Hàn Quốc làm nông nghiệp.": "28dd8d661e1b", "Buổi tối mình nên bớt dùng máy lạnh.": "59185aa0b0b0", "Bạn có mua được vé buổi hòa nhạc không?": "c79d5552252b", "Chưa có, họ đang xin giấy phép.": "0e2c35e20519", "Chắc vùng đó sẽ có thêm việc làm.": "ea8917f2b620", "Có người bị thương.": "4702e6ead0ca", "Có, cà phê hòa tan rất được ưa chuộng.": "4b54ecb7484f", "Có, hôm nay có giảm giá.": "4c44afb8b53f", "Có, luật mới hỗ trợ doanh nghiệp nhỏ.": "84dbbb484b45", "Có, mình ăn nhé.": "2aeac0214e6d", "Giá vàng hôm nay lại tăng rồi.": "bd7b6bc3930d", "Hay quá, mình sẽ mua sắm ở đó.": "88fc4daee2dc", "Hải Phòng vừa khởi công nhà máy đất hiếm.": "2d64305f150e", "Không, vé bán hết nhanh quá.": "b6c9dd76a45d", "Mở công ty mới có được giảm thuế không?": "440125b5f4de", "Nghe nói thu nhập ở đó khá cao.": "682115265652", "Nghe nói tháng sau là có rồi.": "132976508b49", "Ngân hàng này có chi nhánh ở miền Nam không?": "211acbb91479", "Nhiều lắm, cuối tuần còn có khuyến mãi.": "cfc0f28dbbe9", "Nhà mình nhớ kiểm tra bình ga thường xuyên nhé.": "f1b7722aa4f8", "Năm nay Việt Nam nhập khẩu nhiều kỷ lục.": "8808b87516b2", "Năm nay công ty có thưởng Tết sớm không?": "a0540bdebca7", "Phần lớn là linh kiện điện tử.": "41ec08cb6788", "Siêu thị có bán nhiều hàng Hàn Quốc không?": "1414b17fa20d", "Sân bay mới sẽ có cửa hàng miễn thuế đấy.": "19a0421c3ecb", "Tháng này tiền điện nhà mình cao quá.": "37a1b7c0d352", "Việt Nam sắp xây nhà máy điện hạt nhân.": "3fe059dd71b8", "Vâng, là nổ ga.": "f9770406d5c4", "Vé cáp treo có giảm giá không?": "dcd3bd369820", "Vậy mình đợi thêm rồi hãy mua.": "0b83b66b919b", "Vậy sẽ cần nhiều kỹ sư giỏi.": "aaec293976f1", "bình ga": "5929d8bce728", "cà phê hòa tan": "a2423b86dd69", "hàng Hàn Quốc": "3500bc5e76c4", "hàng chính hãng": "473db47011cf", "hạt cà phê": "4a6405b9302d", "thời vụ": "a8c3940673f5", "Đường này có chuyện gì?": "b57250dc063a", "Được, nhưng quét mã thì nhanh hơn.": "54db8bf537c2", "Ở Hàn Quốc cũng bán cà phê Việt Nam à?": "d660cd1bd596", "Ở đây có nổ không?": "2d402fdc899d", "Ở đây trả bằng tiền mặt được không?": "5974b49d9c2d", "Ở đây ăn cơm không?": "abccc8db6f1a", "Ừ, an toàn là trên hết.": "a955f1e20828", "Có. Sự cố rút tiền ở ngân hàng.": "a3d8b75c1f71", "Công ty có vấn đề gì không?": "253d014bff61", "Hoa quả này đã kiểm tra chưa?": "c81ead1d6efc", "Họ sản xuất thuốc và vắc-xin mới.": "3e3fdd42dec5", "Không, tôi không mang đồ cấm.": "810111a4d778", "Lãi suất ngân hàng bây giờ cao không?": "4c1fba40e66d", "Món này có ngon không?": "03f03aebf392", "Ngon lắm, hơi chua một chút.": "c794f63e64dd", "Trong túi có đồ cấm không?": "e78f0b8550e9", "Vâng, lãi suất đang tăng cao lắm.": "b924460a8122", "Vâng, đã đóng gói xong rồi.": "d98eacb66073", "đậu phụ": "1e96e52a6a77"}