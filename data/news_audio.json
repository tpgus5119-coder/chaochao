{"Bạn đang ở phòng trọ à?": "86954541b409", "Bạn định mua nhà chưa?": "7b37187b2072", "Chưa, lãi suất còn cao quá.": "206e205c44bd", "Chỉ số giảm năm phiên liên tiếp rồi.": "04b80b0a1893", "Chủ yếu là lắp ráp và kiểm tra.": "71a2f475b642", "Có chuyến bay thẳng đi Praha không?": "8cf55b974a4e", "Có, Vietjet mới mở tháng này.": "3c4c0e6f1236", "Có, kỹ thuật này tốt.": "ac2ee35c24dd", "Công ty có kỹ thuật mới không?": "8a43653488ce", "Dự kiến ngày hai mươi tư tháng mười hai.": "64f061bc0eea", "Hạn cuối là tháng năm năm sau.": "86f5e77a623e", "Khoảng một nghìn người một chuyến.": "8ab67d906368", "Mạng ở Hà Nội nhanh không?": "beaaa3bea1c2", "Nhà tuyển dụng cần kỹ năng gì nhất?": "5ced90213f94", "Quản lý thời gian và giải quyết vấn đề.": "ad3a10c1b749", "Rất nhanh, đứng thứ năm thế giới.": "49ca094edc17", "Sân bay Long Thành bao giờ mở?": "0b47a0dce0e9", "Tàu này chở được bao nhiêu người?": "97940df24ca9", "Việt Nam có làm chip không?": "b9a6c53c76de", "Việt Nam sắp có sàn tiền mã hóa chưa?": "21fb73488f93", "Vâng, đi ạ.": "90b4a93fc038", "Xe máy ở đường nhiều quá.": "96da0b6191c5", "chuyến bay quốc tế": "87b4781572e0", "công chúa": "02ca6a54f944", "giải quyết vấn đề": "5846a7d1215c", "lương khởi điểm": "b9e27b72df1a", "mạng di động": "79f211a0e269", "quản lý thời gian": "d541e6b8d5d1", "sinh viên tốt nghiệp": "3f9e2ef60b73", "thanh khoản": "f2d19faedd32", "tiền mã hóa": "69c01dbf87f1", "vay ngân hàng": "3a4555b1e668", "Đi ăn cơm không?": "141e3d7a6fca", "Đúng rồi. Xe điện cũng tăng nhiều.": "46db90326476", "đường bay": "239b8f197c09", "đường băng": "b23a1dbbdacb", "Ừ, ở thành phố ai cũng vậy mà.": "41c9f08a0aaa", "Giờ đi làm kẹt xe lắm.": "5e6cb73938d2", "Tôi đi văn phòng bây giờ?": "40b4675b5f21", "Vâng, anh đi làm việc.": "c1226b252066", "Đi biển không?": "a36a9cb06f1f", "Đi chứ, đẹp lắm.": "7abe041e57dc", "Đường này hay kẹt xe không?": "316534b1bdd7"}