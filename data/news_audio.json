{"Anh đã mua vé ca nhạc chưa?": "11e52589c5d5", "Chưa, hết vé rồi anh ạ.": "87db65013c2d", "Chưa, tháng sau mới hết hạn.": "583fad53e35a", "Có, bạn đi chợ mua sắm.": "df8408050b04", "Có, cửa hàng này có bán.": "29d475f9c8cd", "Visa của anh hết hạn chưa?": "3139d802a852", "hết phòng": "053814649732", "Ở đây có bán bánh mì không?": "8dd34ddd34ce", "Ở đây có mua sắm không?": "f53dbbf1ff25", "Chị có tiền không?": "bcba1f41f59a", "Có. Anh làm gì?": "d28119360b22", "Anh đã nhận được thị thực chưa?": "8bbedaa488c4", "Bạn có xem phim hoạt hình Hàn Quốc không?": "a9d9f375fda8", "Bạn dám đi taxi không có tài xế không?": "846bf9a0ff8a", "Bạn kiểm tra số dư tài khoản thế nào?": "7932f60487f3", "Bạn đi làm bằng xe buýt không?": "a3baa4b46a22", "Bạn đã mua bảo hiểm nhân thọ chưa?": "b49cf7f99b84", "Bạn định mua căn hộ không?": "6da25c5fbe12", "Chúng tôi bán mỹ phẩm Hàn Quốc.": "ec294923632b", "Chưa, tôi vẫn đang chờ kết quả.": "94d074203445", "Chưa, tôi đang tìm hiểu.": "6642931c34ab", "Có, nhiều nhà máy Hàn Quốc lắm.": "af2026b29333", "Có, nhất là về thương mại.": "d72d1f3eb88d", "Có, tôi dùng xe buýt hai lần một tuần.": "938a4a6faf18", "Có, tôi hay xem với em gái.": "ca3b495bd1fe", "Công ty bạn bán sản phẩm gì?": "7e43d0e6a556", "Công ty bạn làm linh kiện gì?": "d0d5e5ed2ce1", "Dự kiến là cuối năm nay.": "cd7dd47d1b58", "Em chuẩn bị xong rồi ạ.": "9f15cf942796", "Em đã chuẩn bị hồ sơ chưa?": "f714c2f45d9b", "Giá cao quá, tôi thuê nhà trước.": "9dbbef8b81f0", "Giảm rồi, nhà đầu tư nước ngoài bán nhiều.": "79749fdf7750", "Linh kiện điện cho trung tâm dữ liệu.": "1d5f0231ee1c", "Nhà máy này sắp mở rộng à?": "cbdf643e0ff5", "Nếu bạn là thực tập sinh thì được miễn.": "be339542e045", "Sao anh đến làm muộn thế?": "3cd4bc1fe75e", "Thuốc này sản xuất ở đâu?": "7ecd56a131e6", "Thử một lần chắc cũng thú vị.": "ede1dbc3c033", "Tôi có cần giấy phép lao động không?": "dcbf5eefa2cd", "Tôi xem trên ứng dụng ngân hàng.": "87930d27e2c5", "Việt Nam hợp tác với châu Âu nhiều không?": "52300ffdba6f", "hoạt hình": "8d910f967392", "nghị định": "7b1c1b33c9b1", "xe tự lái": "9e0a97077057", "Đúng rồi, công ty đang đầu tư.": "ca9fdca4763f", "Đường ngập nên bị kẹt xe.": "b17b9c6a3cc8", "Ở nhà máy tại Đồng Nai.": "09123af4fd6d", "Ở Đồng Nai có nhiều công ty Hàn Quốc không?": "99aa4313942f", "Ứng dụng này hứa kiếm tiền dễ lắm.": "6e48e1d2c201", "Ừ, tôi phải tiết kiệm hơn.": "a7522cf5c52e"}