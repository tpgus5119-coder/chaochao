{"Anh đi du lịch Việt Nam không?": "7e12b39195bc", "Anh đã đặt bàn nhà hàng chưa?": "0b12b8835a30", "Chính sách du lịch mới này tốt không?": "498a3368758a", "Hội nghị này ở đâu?": "4a2de087840f", "Tôi đặt bàn rồi, tối nay đi.": "3cdd96117381", "Vâng, nó giúp phát triển kinh tế và việc làm.": "34503b61933e", "Vâng, tôi có đi. Khách Hàn Quốc nhiều.": "66f47c0fd9ce", "Ở khách sạn Lotte.": "dcbac180124a", "Bạn biết con đi đâu không?": "586bc974b74c", "Con tôi mất rồi. Giúp tôi!": "1d0a2a8f27ce", "Nhà hàng này có món ăn ngon không?": "e6164b99af59", "Vâng, món ăn ở đây rất ngon.": "54876bfa7e4a", "Đúng rồi, vợ tôi là người Việt.": "bf7c855125cb", "Có, món ăn ở đây rất ngon.": "f06796c78061", "Có, vé bây giờ rất rẻ.": "bf2b77b28d27", "Vé máy bay đi Việt Nam có rẻ không?": "0f1e4f32b6ab", "Anh đi đâu?": "65806be4b14d", "Bạn có mua bảo hiểm nhân thọ không?": "38ae70c17ddd", "Chính phủ có chính sách mới không?": "b663bf61f090", "Chưa đủ, nhiều người phải thuê nhà gần khu công nghiệp.": "9a0d08c568b2", "Chưa, tôi vẫn đang tìm hiểu.": "6b7f3cb4bcf7", "Chủ yếu sang Trung Quốc.": "a624d8879dc8", "Có một ít, phòng khi khẩn cấp.": "e486fa60c17f", "Có thể, vì nhiều điện thoại làm ở Việt Nam.": "0dbaa6ece323", "Có, năm nay đã bị kiểm tra hai lần.": "2dad83581b4f", "Có, phí trên ứng dụng giảm một chút.": "49073a163d8a", "Công ty bạn có bị kiểm tra thuế không?": "f15c155aeb4f", "Công ty bạn có định rút khỏi Việt Nam không?": "ff1d0f6848a2", "Công ty có ký túc xá cho công nhân không?": "240b3acc4d71", "Hơi đắt, nhưng quán rất đẹp.": "bbfc7d84b310", "Họ dùng đường từ mía thay cho dầu mỏ.": "c63cabe8a264", "Họ sản xuất linh kiện chất bán dẫn.": "6f49ab88716a", "Khá tốt, lợi nhuận tăng nhiều.": "26e1ee007a23", "Không cao lắm, nhiều người thấy chưa đủ sống.": "eead94dcb887", "Không, chi phí ở đây vẫn rẻ hơn nhiều nước.": "e4be6cdb45e8", "Ly cà phê này giá bao nhiêu?": "abd64383331f", "Lương giáo viên ở Việt Nam có cao không?": "a261793ba0d9", "Ngành dệt may năm nay thế nào?": "fc972c83ec09", "Nhà bạn có trữ nước uống không?": "baa186dafa58", "Nhà máy mới ở Hải Phòng sản xuất gì?": "6712dd1e9597", "Nhà máy này dùng nguyên liệu gì?": "d56f7c2b1fdd", "Năm nay nhiều người mở công ty không?": "74ef302e83b6", "Năm sau kinh tế Việt Nam có tăng trưởng mạnh không?": "0b1c0770d9f6", "Nếu Mỹ tăng thuế, điện thoại có đắt hơn không?": "1ee31a6f5571", "Quốc hội muốn tăng trưởng rất cao.": "6ec2ad38c96c", "Sầu riêng Việt Nam bán đi đâu nhiều nhất?": "5745f5b92d82", "Tôi đi làm ở nhà máy mới.": "061bbaac345c", "Vâng, có chính sách phát triển du lịch.": "41694b032655", "Vâng, đi xe buýt rất tiện.": "cbd604119055", "chi phí sinh hoạt": "e70c82ac2c4d", "khu kinh tế": "5b1df0efad2e", "nhân thọ": "ef37f6fe9929", "sở hữu trí tuệ": "e48602b79ff2", "thị trường nội địa": "c539d5c79b69", "tin tặc": "fa2d8083b5c7", "tư vấn viên": "e0b6271dd953", "Ít hơn năm ngoái một chút.": "0d8b8e23fbe8", "Đi qua cầu đi bộ kia đi.": "15a74751333c", "Đi xe buýt có tiện không?": "40df2fdf8ef7", "Đi xe ôm bây giờ có rẻ hơn không?": "0728c1aab914", "Đường này đông xe, sang đường thế nào?": "a92193535fce", "đông lạnh": "953be1476609"}