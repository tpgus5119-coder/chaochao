{"sản xuất": "72401f3a9337", "ngân hàng": "a2363d974f36", "nhà máy": "f9ea2d37946a", "nước": "097a0d78359a", "tăng": "ac90bd3bd7e7", "đường": "e130a9473b5e", "nhà": "93b1aa34a1a4", "giá": "049f4321345f", "tiền": "ee22dbdde14f", "an toàn": "4bd78c10c591", "công ty": "2a8dec0c6fe4", "thị trường": "34be225b7e87", "mưa to": "cb964a1e6738", "mua": "c29de68cf86e", "khách": "568278451006", "tàu điện": "5868215610c9", "Buổi sáng ở đây có đông không?": "1192d13ad4cf", "Công ty có đang tuyển nhân viên không?": "51a7bebe1e05", "Trời mưa to quá, đi cẩn thận nhé!": "03895238955c", "Vâng, luôn đông. Anh/chị chờ khám bệnh nhé.": "1affc8ffe1c9", "Vâng, tôi đi xe máy chậm thôi.": "d354963263d8", "lương": "a4451e3bf16f", "Đúng rồi, dạo này rất thiếu người.": "2becaf3b95e1", "Bạn đã chuẩn bị phỏng vấn chưa?": "bd497fbcb498", "Món ăn ở đây có ngon không?": "4464a51d99f0", "Ngon lắm, giá cả cũng rẻ.": "77befda33d75", "Nhà hàng này đóng cửa rồi à?": "10809bfc354d", "Tôi đã chuẩn bị xong rồi.": "fac87141f375", "Vâng, nhà hàng đóng cửa rồi.": "fb56f924475a", "Giá thuê văn phòng ở đây thế nào?": "98be0e4247f3", "Giá tốt và thông tin rất rõ ràng.": "3f49a4161ab9", "Hôm nay chúng ta ăn chay nhé?": "015d83e53aac", "Nhà hàng này có ngon không?": "0598b097ef92", "Rất ngon và nổi tiếng.": "e5735249d92b", "rượu vang": "8974dc8a6008", "thịt bò": "e267502d43d9", "ăn chay": "0f6a65a2445a", "Được, nhà hàng này rất ngon.": "c56d7b24bb27", "Biển Mũi Né có sạch không?": "414144fb5767", "Bạn có đầu tư chứng khoán không?": "3c74cd692875", "Chúng ta cần chuẩn bị cho cuộc họp.": "67eb6bec2c7b", "Có, tôi có đầu tư vào công ty Việt Nam.": "335f72c691d6", "Không, biển Mũi Né có nhiều rác.": "e6dbb6713352", "Nhà hàng này có đông khách không?": "b9812f0c59e1", "Năm sau đường mới sẽ xong.": "2ea9322a7054", "Thành phố Hồ Chí Minh lớn không?": "62e809b0afa6", "Vâng, buổi tối khách rất đông.": "20ad2f8565af", "Vâng, rất lớn và đang phát triển.": "4f9232dd1571", "Vấn đề này phải làm sao?": "9fbcb0e0f37f", "chứng khoán": "c3bcc9248085", "Đường này bao giờ làm xong?": "0b35502e339c", "đầu tư": "2decf88c1a56", "Bé chơi ở đây an toàn không?": "acb353bb3d97", "Chỉ được nghỉ một ngày thôi.": "0ae6fa8325de", "Có, giá cổ phiếu đang tăng.": "6f3266826fe0", "Công ty này có tốt không?": "3c334a078bcc", "Gia đình anh đồng ý chưa?": "d55f3c0f044b", "Không, không an toàn lắm.": "da7da55888be", "Lãi suất bây giờ rất cao đấy.": "fcaccbab446d", "Ngày nghỉ này được nghỉ mấy ngày?": "e288f0daf1d5", "Rồi, họ đồng ý rồi.": "324a70cfbd29", "Tôi muốn gửi tiết kiệm ngân hàng.": "7d14c988a28e", "Vâng, hãy đi chậm và an toàn.": "0057366931ad", "Vâng, mới mở một siêu thị lớn.": "294d3893ee0a", "cảnh sát": "d9125a9ae5ad", "cổ phiếu": "789056e6843b", "một ngày": "9582391fb597", "Đi xe máy có nguy hiểm không?": "84fdc4ea1c6e", "Ở đây mới mở siêu thị à?": "1eecaf60baf6", "Có, pin có. Pin mới cũng có.": "f7f467ba943a", "Hôm nay có giá mới không?": "25627ef2c76b", "Nhà máy này có pin không?": "5b7b1ca88fa7", "Vâng, giá giảm một chút.": "e15eba726499", "có": "44092dbc1f26", "Cuối tuần này có triển lãm không?": "0ad8cb60b8ef", "Có, triển lãm mở cửa hôm nay.": "beed45dbe3fa", "Có, tàu này đi rất nhanh.": "a241a3935ff2", "Công ty vay tiền được không?": "84e29c03f646", "Sân bay mới ở đây à?": "33176bd7d8ce", "Thanh long dạo này rẻ quá.": "6960fc51e102", "Tàu điện này đi thành phố không?": "1d2f209eea94", "Vâng, giá thanh long rất rẻ.": "aca34d4137d4", "Vâng, sân bay mới.": "020ca9c5fcb4", "Xe này là xe điện à?": "e751b5f30242", "thanh long": "77a2284da417", "Đúng vậy. Công ty tôi mua xe mới.": "7635bc87c78d", "Được, ngân hàng đồng ý rồi.": "9fb800d9ba8e", "Có, ngập nhiều. Anh đi đường khác.": "a7ed9c35e2f4", "Giá nhà ở đây có cao không?": "3d2935ea08a8", "Mưa nhiều quá!": "17077783e791", "Nhà máy Việt Nam sắp có chưa?": "69f7ee00e3c6", "Vâng, giá nhà bây giờ rất cao.": "515b59b162ff", "Vâng, sắp có. Sẽ làm sản phẩm mới.": "91bd8aadf778", "Vâng, trời mưa xe đi khó.": "3f79ace74c67", "Đường ngập nước rồi.": "576dad1b7837", "Đường này ngập không?": "11db89f31501", "Đường này vắng không?": "b47f2c7b866e", "Có, đừng đi thuyền bây giờ.": "807435bae261", "Giám đốc có ở công ty không?": "dff5687c3f48", "Hàng hóa này xuất khẩu à?": "54a3e34c8416", "Hôm nay trời có mưa không?": "ddd79004cac0", "Không, giám đốc đi ngân hàng rồi.": "7ee4a28a8fa8", "Vâng, giá sẽ rẻ hơn.": "340e69f21fd7", "Đường ngập, tôi đi làm muộn nhé.": "f7e60d127c55", "Được, anh đi cẩn thận nhé.": "3cbd98fab91b", "Anh mua vé số à?": "379bfa05dfc0", "Bay đi Nga và Nhật Bản.": "db65f63fd807", "Chị có thi chứng chỉ tiếng Anh không?": "6c56e6f9369f", "Có, nhưng thi tiếng Anh khó lắm.": "c10d831e213b", "Có, nó giúp phát triển kinh tế và thương mại.": "a85226d66c85", "Có, nó rất mới và đẹp.": "e42e569a664c", "Có, nếu vi phạm luật giao thông sẽ bị phạt.": "edb3dd858938", "Hôm nay mưa to, có xe taxi không?": "a7fe372cd42b", "Hôm nay tôi đến nhà làm việc nhé?": "cb8c74d4860b", "Hợp đồng này có lợi ích cho công nhân không?": "ca7d84ad2de9", "Không nhiều, chúng ta đi bộ nhé.": "8a624fa10a0e", "Không, tiền đang giảm vì lãi suất thấp.": "3ca8f2d33080", "Máy bay này bay đi nước nào?": "da4173b82b01", "Máy bay này có mới không?": "39f93b9eb308", "Nhà tôi không bán xe.": "ac36b6eb8339", "Tiền trong tài khoản của bạn có tăng không?": "d683b6c84e99", "Vâng, mời anh vào nhà làm việc.": "3884f145e2d8", "Vâng, tôi muốn trúng số.": "601dc597d974", "Xe máy chạy trên đường có nguy hiểm không?": "3e5fdf1560c7", "Xe này giá bao nhiêu?": "aa903841ae8e", "bị phạt": "308cca7a91f3", "mua áo mưa": "3a02bb140736", "trúng": "1ca2f981c956", "vé số": "3fc21663545c", "v표": "694c4370e05a", "đi quốc tế": "7c9dccedda2b", "Bạn làm ở đây?": "d0d8100644d0", "Cái này thịt chó không?": "4157b5f8eec0", "Hôm nay là Tết Trung Thu à?": "f5735363e346", "Không phải. Đây là thịt gà.": "13e97ab62f85", "Không, hôm nay vẫn làm việc.": "ad5d4fc54fc6", "Không. Máy bay cấm pin. An toàn nha.": "45ae39b3b70c", "Rạp phim này có tốt không?": "5c479bf63659", "Trong hành lý có pin. Có được không?": "65e458a004c6", "Vâng, rạp này có nhiều phim hay.": "6770fdc621a1", "Vâng, tôi làm ở nhà máy.": "834644cb1c23", "Công ty sắp hợp tác à?": "c60b0fdfc832", "Hiện tại chưa có nhà ga gần đây.": "2129097d0799", "Nguy hiểm quá, kiểm tra ngay!": "0da8abc38a78", "Trong túi xách có khói kìa!": "d9588599db92", "Tôi thanh toán bằng thẻ được không?": "e0443f92ec08", "Vâng, bánh mì rất ngon.": "586e0947e21d", "Vâng, sẽ có thêm chuyến bay mới.": "584bd74dbacb", "ghế ngồi": "5bbfc334842c", "Đi làm bằng tàu điện được không?": "7139614c4669", "Đi ăn bánh mì nhé.": "cb44501a13e2", "Được, anh quét mã QR nhé.": "584eae5a84b9"}