{"Bạn có đặt phòng khách sạn chưa?": "7f8cd6e1f911", "Chưa đâu, còn lỗ nhiều lắm.": "80117434880e", "Khách sạn cuối tuần này đông không?": "9b04afcfbdc7", "Không, tiền điện giảm rồi.": "2759136dddbf", "Nhanh lắm, không bị tắc đường đâu.": "fa1e2e5ef51c", "Nhà máy mình có đạt mục tiêu không?": "a581aacdecd0", "Rất đông, hết phòng rồi anh ạ.": "ca0eab903301", "Tháng này tiền điện đắt không?": "68641243e8f6", "Tôi đặt phòng rồi, đông lắm.": "da864618ec6c", "Xe buýt đi sân bay có nhanh không?": "67e822214539", "do thu": "7b556c4b8189", "thưa lỗ": "77563e1086de", "Anh ấy làm ở đây à?": "2c4d4f5311a2", "Chúng ta đi tàu không?": "3db77f3ab824", "Chắc sẽ cần nhiều nhân viên hơn.": "a09c4e48c105", "Có, lãi cao nhất từ khi niêm yết.": "065f7e7e5d70", "Có, lãi suất khá cao.": "4a380ff1528e", "Có, một nhà máy có hơn ba nghìn người.": "6b5fe9c9c724", "Công ty Hàn Quốc ở đây tuyển nhiều người không?": "2d6fed951be8", "Công ty mình đang quyên góp à?": "e8c15608fe2c", "Công ty này quý ba có lãi không?": "dc66154f17fe", "Cổ phiếu này lãi tốt mà sao giảm?": "58a383e1b82c", "Giá vàng hôm nay tăng rồi.": "75549a613af7", "Gửi tiết kiệm bây giờ có lợi không?": "a49b8235e2f7", "Hội chợ hàng Hàn Quốc mở đến khi nào?": "bd86048efd4d", "Nghe nói giá điện sắp giảm à?": "2822f0d18d23", "Nghe nói vài năm nữa.": "a2cf677abf2c", "Ngành du lịch sẽ được hỗ trợ thêm.": "ae3568f0b0bd", "Nhà máy mình cần máy ép nhựa mới.": "739272d0919a", "Nhớ bàn giao công việc trước nhé.": "9587ec01c803", "Sẽ có nhiều quỹ đầu tư đến.": "cc1f14b6c587", "Thành phố vừa duyệt nhiều dự án lớn.": "664dfb078b94", "Tháng này đi đảo được không?": "7bd1e823c8ea", "Thị trường khó đoán lắm.": "0d4c7f6a8c8c", "Trung tâm tài chính mới có gì hay?": "6e9ed494f09c", "Tuyến đường sắt mới khi nào xong?": "a92c1438cb1a", "Tuần sau tôi nghỉ phép năm.": "36e0b14621a6", "Tập đoàn này lớn nhất Việt Nam phải không?": "cea1c5a6aeac", "Vâng, anh ấy làm công ty này.": "8b2330b7883a", "Vâng, biển rất đẹp.": "569e9f3c24bd", "Vâng, để giúp đỡ trẻ em.": "3d27e2fcfa32", "Vậy chờ thêm rồi hãy mua.": "09124658eb4a", "Vậy sẽ có thêm việc làm.": "95179766c14e", "cầu cạn": "32e0f7d15a8a", "giá sàn": "bde035829b55", "giá vàng": "005b4216d788", "giá vốn": "a303ab9196e1", "hậu cần": "6b92c08a0c05", "máy lọc nước": "25a4f9ef8d6e", "máy ép nhựa": "204099d92206", "nghỉ dưỡng": "89527dd1af3f", "nhẫn vàng": "666a3e01579f", "quyên góp": "ba19a7a89862", "thuế tiêu thụ đặc biệt": "c300c8f709cd", "tỷ phú": "5f9630ec9506", "Đúng, nhiều người muốn vào làm ở đó.": "43c873facd33", "Được, trời nắng và biển rất đẹp.": "b48500aa19bb", "Đến ngày mai, bạn đi cùng không?": "88394e52e4fe", "Để tôi hỏi bên kỹ thuật.": "320da46be745", "Ừ, có thể từ tháng sau.": "bfade3463182"}