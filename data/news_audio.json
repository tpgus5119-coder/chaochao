{"biển": "9825e2ede8d7", "hỗ trợ": "b4cfc2f10416", "thịt": "88be61f198c4", "Anh làm việc ở nước ngoài à?": "ad47a3b123ce", "Có, công ty có nhiều tiền gửi ngân hàng.": "09b6f6658b87", "Công ty có nhiều tiền không?": "2fb93e24d284", "Hàng này có cần kiểm tra không?": "b1f908ce9b4a", "Nhà này giá cao không?": "a4248db3f53f", "Vâng, giá nhà này rất đắt.": "8b499f4a2473", "Vâng, hôm nay miễn phí.": "3953d90de40c", "Vâng, phải qua kiểm tra điện tử.": "d30614003cad", "Vâng, tôi làm việc ở đây theo hợp đồng.": "62bc552635a7", "Xe buýt này miễn phí không?": "92a384873ed8", "chính phủ": "a4a0bb2a68d0", "ga": "72b6ef474440", "kiểm": "7bc00b5ebd29", "lãi": "7343e319be25", "lớn": "ad2806d063f2", "ngày lễ": "53e8e2cfe671", "nhỏ": "61199b29b71d", "pháp": "6b8e8772fb36", "phạt": "693dc9aeba65", "qua": "104c8fa3f485", "quy định": "1777102f2c33", "thời gian": "5e1b814ef29f", "tàu điện": "5868215610c9", "về nước": "f3872c1300e7", "đi lại": "ad64ebff6958", "Anh muốn đi đâu nay?": "a52700bd7f7a", "Cái này giá bao nhiêu tiền?": "bfd2ca36d38e", "Có, không có giấy sẽ bị phạt.": "2f8eca8ac076", "Cửa hàng này dùng ảnh sai hợp đồng không?": "9615efe33dcd", "Hàng này tốt nên hơi đắt.": "3866d955b773", "Tôi cần giấy phép làm việc không?": "24a843bd1fcc", "Tôi muốn đi Nha Trang.": "d6cc56ed5374", "Vâng, đi rất nhanh.": "cd95d7d10711", "chủ": "40fac9da45d1", "công": "5373bc8f47ee", "cửa hàng": "578eb38b5982", "luật": "ab8482afa944", "nay": "66a4c6b5a7d3", "quảng cáo": "535884bce018", "Đúng, đây là vấn đề lớn.": "b2901119bfd4", "Đường mới đi nhanh không?": "cdc51f49f162", "Có vé máy bay đi không?": "be953a54ffb1", "Có, máy mới làm rất nhanh.": "fea99ac00835", "Có. Giá rẻ.": "5b8795ece4ef", "Cảnh sát đang kiểm tra xe phải không?": "78290743af44", "Hàng này có tốt thật không?": "a4ebef7ce1df", "Hôm nay xưởng làm nhiều hàng không?": "9dea068fb727", "Không, quảng cáo đó bị sai.": "448c7f43c0d5", "Vâng, đây là thịt gà xuất khẩu đầu tiên.": "e14c6c22f585", "cảnh sát": "d9125a9ae5ad", "dừng": "8181c0c02f